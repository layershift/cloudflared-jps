version: 0.1
type: update
name: 'Cloudflared'
homepage: https://github.com/layershift/cloudflared
id: 'cloudflared'
description:
  short: Cloudflared tunnel client
logo: cloudflared.png
categories:
  - apps/others

targetNodes:
  nodeType:
    - "*"

onInstall:
  deployRPM:
    nodeId: ${targetNodes.nodeGroup}

onAfterRedeployContainer:
  - forEach(event.response.responses):
      deployRPM:
        nodeId: ${@i.nodeid}

onAfterScaleOut:
  - forEach(event.response.nodes):
      deployRPM:
        nodeId: ${@i.id}

onUninstall: removeRPM

actions:
  deployRPM:
    user: root
    cmd[${this.nodeId}]:
      - curl -fsSL https://pkg.cloudflare.com/cloudflared-ascii.repo -o /etc/yum.repos.d/cloudflared.repo
      - rpm -q cloudflared >/dev/null 2>&1 || yum -q install cloudflared -y
      - 'echo -e "Cmnd_Alias CLOUDFLARED = /usr/bin/cloudflared, /usr/local/bin/cloudflared\nALL ALL = (ALL) NOPASSWD: CLOUDFLARED" | tee /etc/sudoers.d/cloudflared >/dev/null'
      - chmod 0440 /etc/sudoers.d/cloudflared
      - visudo -cf /etc/sudoers.d/cloudflared || rm -f /etc/sudoers.d/cloudflared

  removeRPM:
    user: root
    cmd[*]:
      - cloudflared service uninstall >/dev/null 2>&1 || true
      - yum -q remove cloudflared -y
      - rm -f /etc/yum.repos.d/cloudflared.repo
      - rm -f /etc/sudoers.d/cloudflared
